## Unit Testing Standards

### Service Test Template
```java
@ExtendWith(MockitoExtension.class)
class FeatureServiceTest {
    @Mock private FeatureRepository repository;
    @Mock private FeatureMapper mapper;
    @InjectMocks private FeatureServiceImpl service;

    @Test
    @DisplayName("findById: returns DTO when entity exists")
    void findById_whenExists_returnsDto() {
        // Given
        UUID id = UUID.randomUUID();
        FeatureName entity = new FeatureName();
        FeatureResponseDto expectedDto = new FeatureResponseDto();
        when(repository.findById(id)).thenReturn(Optional.of(entity));
        when(mapper.toResponseDto(entity)).thenReturn(expectedDto);

        // When
        FeatureResponseDto result = service.findById(id);

        // Then
        assertThat(result).isEqualTo(expectedDto);
        verify(repository).findById(id);
    }

    @Test
    @DisplayName("findById: throws ResourceNotFoundException when not found")
    void findById_whenNotFound_throwsException() {
        UUID id = UUID.randomUUID();
        when(repository.findById(id)).thenReturn(Optional.empty());

        assertThatThrownBy(() -> service.findById(id))
            .isInstanceOf(ResourceNotFoundException.class);
    }
}
```

### Controller Test Template
```java
@WebMvcTest(FeatureController.class)
class FeatureControllerTest {
    @Autowired private MockMvc mockMvc;
    @MockBean private FeatureService service;
    @Autowired private ObjectMapper objectMapper;

    @Test
    @DisplayName("POST /api/v1/features: returns 201 with created resource")
    void create_withValidRequest_returns201() throws Exception {
        FeatureRequestDto request = new FeatureRequestDto("Test Feature");
        FeatureResponseDto response = new FeatureResponseDto(UUID.randomUUID(), "Test Feature");
        when(service.create(any())).thenReturn(response);

        mockMvc.perform(post("/api/v1/features")
                .contentType(MediaType.APPLICATION_JSON)
                .content(objectMapper.writeValueAsString(request)))
            .andExpect(status().isCreated())
            .andExpect(jsonPath("$.name").value("Test Feature"));
    }
}
```

